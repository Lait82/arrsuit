# yaml-language-server: $schema=https://schemas.recyclarr.dev/v8/config-schema.json
# =========================================================================
#  ESTE ARCHIVO LO GENERA configure-stack.py - NO EDITARLO EN /srv/config
#
#  La plantilla vive en configs/recyclarr/recyclarr.yml.tmpl y lo que se
#  elige (quality profiles y grupos de custom formats) sale de
#  configs/services_setup.conf, en .recyclarr. Editar ahi y volver a correr
#  el orquestador.
#
#  QUE HACE RECYCLARR: baja las TRaSH Guides y las aplica a Radarr y Sonarr.
#  Concretamente sincroniza tres cosas:
#    - quality_definition -> los tamanios min/max por calidad
#    - quality_profiles   -> el perfil en si (que calidades acepta y en que
#                            orden), traido del guide por su trash_id
#    - custom_format_groups -> los custom formats y sus puntajes
#
#  base_url usa el nombre del contenedor y no la IP de Tailscale: recyclarr
#  vive en la red 'media' y le llega a los otros por DNS interno de Docker.
#
#  OJO: cambiar los quality profiles hace que Radarr/Sonarr re-evaluen lo que
#  ya tenes descargado y encolen upgrades de lo que ya no llega al cutoff.
# =========================================================================

radarr:
  movies:
    base_url: {{RADARR_URL}}
    api_key: {{RADARR_API_KEY}}

    quality_definition:
      type: movie

    quality_profiles:
      - trash_id: {{RADARR_PROFILE_ID}}   # {{RADARR_PROFILE_NAME}}
        # reset_unmatched_scores: pone en 0 los custom formats que el perfil no
        # menciona. Sin esto, un puntaje que hayas tocado a mano en Radarr
        # sobrevive y compite con los del guide, y el resultado es un perfil
        # mitad-guide mitad-tuyo que no se parece a lo que dice la doc.
        reset_unmatched_scores:
          enabled: true

    custom_format_groups:
      add:
{{RADARR_CF_GROUPS}}

sonarr:
  series:
    base_url: {{SONARR_URL}}
    api_key: {{SONARR_API_KEY}}

    quality_definition:
      type: series

    quality_profiles:
      - trash_id: {{SONARR_PROFILE_ID}}   # {{SONARR_PROFILE_NAME}}
        reset_unmatched_scores:
          enabled: true

    custom_format_groups:
      add:
{{SONARR_CF_GROUPS}}
