# =========================================================================
#  .env.example - plantilla de variables para setup-host.sh
#
#  USO:
#    cp .env.example .env
#    nano .env          # completar los valores reales
#
#  NUNCA commitear el .env real (tiene secretos). Ya esta en .gitignore.
# =========================================================================

# --- MaxMind GeoLite2 (para el geo-bloqueo AR) --------------------------
# Cuenta gratis en https://www.maxmind.com/en/geolite2/signup
# Si dejas estos vacios, el script se configura SIN geo-bloqueo (y avisa).
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# --- SSH ----------------------------------------------------------------
# Puerto SSH del host. Se abre en UFW para no lockearte. Default: 22.
SSH_PORT=22

# NOTA: la IP de Tailscale NO la ponés a mano. El script setup-host.sh la
# detecta con 'tailscale ip -4' y la ESCRIBE aca automaticamente, para que
# el docker-compose.yml pueda leerla como ${TAILSCALE_IP} en los binds.
# La linea de abajo la sobreescribe el script; dejala como esta.
TAILSCALE_IP=


# --- Indexers de usenet -------------------------------------------------
# API key de tu cuenta de nzb.life (en la web: Profile / My Account).
# La usa configure-stack.py para cargar el indexer en Prowlarr.
# Que indexers se cargan se define en configs/services_setup.conf, en
# .prowlarr.indexers; cada uno apunta aca con "apiKeyEnv".
NZB_INDEXER_API_KEY=

# --- Proveedor de Usenet (news server) ----------------------------------
# El host, el puerto y la cantidad de conexiones NO son secretos y van en
# configs/services_setup.conf (.sabnzbd.server). Aca solo las credenciales.
USENET_USER=
USENET_PASS=
USENET_HOST=