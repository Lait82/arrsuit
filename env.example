# =========================================================================
#  env.example - plantilla de variables del stack
#
#  Lo leen configure-stack.py y docker compose.
#
#  USO:
#    cp env.example .env
#    nano .env          # completar los valores reales
#
#  NUNCA commitear el .env real (tiene secretos). Ya esta en .gitignore.
# =========================================================================

# --- ProtonVPN / WireGuard ----------------------------------------------
# La private key del archivo .conf que genera Proton (ver GUIA paso 1).
# Sin esto gluetun no conecta y qBittorrent no descarga.
WIREGUARD_PRIVATE_KEY=

# --- MaxMind GeoLite2 (para el geo-bloqueo) -----------------------------
# Cuenta gratis en https://www.maxmind.com/en/geolite2/signup
# Las usa el contenedor geoipupdate, que baja la base que lee nginx.
# Si las dejas vacias el stack levanta igual pero SIN geo-bloqueo (y avisa).
# Que paises pasan se define en configs/services_setup.conf, en
# .nginx.geoBlock.countries.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# --- SSH ----------------------------------------------------------------
# Puerto SSH del host. El paso 1 lo abre en UFW y cierra el resto.
# OJO: si no coincide con tu puerto SSH real, te quedas afuera del server.
# Default: 22.
SSH_PORT=22

# NOTA: la IP de Tailscale NO la pones a mano. El paso 1 del orquestador la
# detecta con 'tailscale ip -4' y la ESCRIBE aca automaticamente, para que
# el compose pueda leerla como ${TAILSCALE_IP} en los binds.
# La linea de abajo la sobreescribe el script; dejala como esta.
TAILSCALE_IP=


# --- Indexers de usenet -------------------------------------------------
# API key de tu cuenta de nzb.life (en la web: Profile / My Account).
# La usa configure-stack.py para cargar el indexer en Prowlarr.
# Que indexers se cargan se define en configs/services_setup.conf, en
# .prowlarr.indexers; cada uno apunta aca con "apiKeyEnv".
NZB_INDEXER_API_KEY=

# --- Proveedor de Usenet (news server) ----------------------------------
# El host, el puerto y la cantidad de conexiones NO son secretos y van en
# configs/services_setup.conf (.sabnzbd.server). Aca solo las credenciales.
USENET_USER=
USENET_PASS=
USENET_HOST=