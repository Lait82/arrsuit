# =========================================================================
#  Reverse proxy para Jellyfin - Manu
#  - Escucha en :80 (HTTP, sin TLS: modelo de amenaza = bots de internet)
#  - Geo-bloqueo: solo pasa Argentina (ver bloque geoip2 en nginx.conf)
#  - Rate limit SOLO en el endpoint de login
#  - proxy_pass a Jellyfin bindeado en 127.0.0.1:8096
# =========================================================================

# Rate limit para el endpoint de autenticacion (10 req/min por IP)
limit_req_zone $binary_remote_addr zone=jelly_login:10m rate=10r/m;

server {
    listen 80;
    server_name _;   # responde en la IP pelada

    # --- Geo-bloqueo: solo AR ---
    # $allowed_country se define en el bloque 'map' de nginx.conf
    if ($allowed_country = no) {
        return 403;
    }

    # Rate limit al login de Jellyfin (authenticatebyname / authenticate)
    location ~* /Users/(authenticatebyname|authenticate) {
        limit_req zone=jelly_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8096;
        include /etc/nginx/proxy_jellyfin.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:8096;
        include /etc/nginx/proxy_jellyfin.conf;
    }
}
