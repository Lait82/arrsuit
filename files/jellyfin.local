# Jail fail2ban para Jellyfin -> /etc/fail2ban/jail.d/jellyfin.local
# 4 intentos fallidos en 1h -> ban de 24h

[jellyfin]
enabled  = true
backend  = auto
port     = http,https
protocol = tcp
filter   = jellyfin
logpath  = /srv/config/jellyfin/log/*.log
maxretry = 4
findtime = 3600
bantime  = 86400
